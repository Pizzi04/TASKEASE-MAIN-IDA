# Copia questo file in .env.local e completa i valori mancanti.

# Pubblici (finiscono nel browser)
NEXT_PUBLIC_SUPABASE_URL=https://aqwbobvsnaickycvtzhx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Dtfze9aqHUSVyZFJb3YVPA_qqSBo_0T
# Indirizzo pubblico del sito (anteprime social, sitemap). Su Vercel, se manca, si usa il dominio di produzione.
NEXT_PUBLIC_SITO_URL=https://www.tuodominio.it

# Segreti (solo sul server, MAI nel codice o su GitHub)
# Supabase → Settings → API Keys → Secret key. Serve per eliminare gli account e inviare le notifiche push.
SUPABASE_SECRET_KEY=

# Notifiche push: genera le chiavi con  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tua-email@esempio.it
# Una stringa lunga e casuale, uguale a quella messa nel Database Webhook di Supabase
PUSH_WEBHOOK_SECRET=

# Manutenzione notturna (/api/manutenzione, vedi vercel.json): una stringa lunga e casuale.
# Su Vercel va messa come CRON_SECRET: Vercel la manda da solo nella chiamata notturna.
CRON_SECRET=

# Controllo anti-bot sull'invio degli SMS (Cloudflare Turnstile). La chiave segreta va SOLO in
# Supabase → Authentication → Attack Protection → CAPTCHA (provider Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
